import socket

def scan(ip, port):
try:
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
s.settimeout(1)
port_status = s.connect_ex((ip, port))

            if port_status == 0:
                return f"[+] Port {port} is open!"
            else:
                return f"[-] Port {port} is closed!"
    except Exception as e:
        return e

def open_ports(ip, port):

    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            port_status = s.connect_ex((ip, port))

            if port_status == 0:
                return f"[+] Port {port} is open!"

    except Exception as e:
        return e

